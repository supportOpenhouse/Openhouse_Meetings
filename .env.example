# Neon Postgres connection string
# Get from https://console.neon.tech → your project → Connection Details → Pooled connection string
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="your-random-32-byte-secret-here"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Authorised redirect URI (prod): https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated admin emails. Anyone in this list gets auto-provisioned as admin on first sign-in.
# Everyone else must be invited by an admin first.
ADMIN_EMAILS="ashish@openhouse.in,rahool@openhouse.in"

# Anthropic API key for Claude (meeting summaries)
ANTHROPIC_API_KEY="sk-ant-..."

# ElevenLabs API key (Scribe v2 transcription)
ELEVENLABS_API_KEY="sk_..."

# Default transcription language (leave empty for auto-detect)
# Options: en, hi, bn, ta, te, mr, gu, pa
ELEVENLABS_LANGUAGE=""

# Vercel Blob — REQUIRED for the direct-upload flow that handles long (>3 min) recordings
# Create token in Vercel dashboard → Storage → Blob → Create store
# Or run: vercel link && vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=""

# Read-only mirror of the CP inventory Postgres DB (channel_partners + cities).
# Optional — leave blank to disable CP auto-lookup in the new-meeting form.
CP_INVENTORY_DB_STRING=""

# CP visits dashboard — pulls daily visit data from a Google Sheet.
# 1. In Google Cloud, create a service account and enable the Google Sheets API.
# 2. "Create key" → download JSON → paste the entire JSON below as a single line.
# 3. Share the sheet with the service-account email (Viewer is enough).
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SHEET_ID="17eEX021t97pGnJasMJ6v7ERE0jezKEC0S8teKepJRWQ"
GOOGLE_SHEET_TAB="Sheet1"

# Salestrail Call Analytics Pull API — auto-imports phone-call recordings.
# Generate the username + password at https://callanalytics.salestrail.io/integration/apidocs
# (the password is shown only once). OWNER credentials pull the whole team's calls.
SALESTRAIL_API_USERNAME=""
SALESTRAIL_API_PASSWORD=""

# Secret protecting the scheduled /api/salestrail/sync cron route. Generate with:
# openssl rand -base64 32 — Vercel sends it as a Bearer token on cron invocations.
CRON_SECRET=""

# Optional — recordings transcribed per sync run (default 8).
SALESTRAIL_BATCH="8"
